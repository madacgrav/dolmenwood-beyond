    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pg": "^8.13.0",
    "prettier": "^3.4.0",
    "puppeteer": "^24.42.0",
    "tsx": "^4.19.0",
    "turbo": "latest",
    "typescript": "^5.7.0",
    "yaml-lint": "^1.7.0"
