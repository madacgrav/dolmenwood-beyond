NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_WORDPRESS_URL=https://your-wordpress-site.com
WORDPRESS_API_URL=https://your-blog.com/wp-json/wp/v2
WORDPRESS_APP_PASSWORD=your-app-password
WORDPRESS_USERNAME=your-username

# Cosmos DB (server-only — never expose to the browser)
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key

# Auth.js session signing secret (generate with: npx auth secret)
AUTH_SECRET=some-long-random-string

# Azure Blob Storage (portraits) + SignalR (live character updates) — server-only
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
SIGNALR_CONNECTION_STRING=Endpoint=https://your-signalr.service.signalr.net;AccessKey=...;Version=1.0;

# Outbound notifications (email via Resend; drain route shared secret)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=onboarding@resend.dev
NOTIFICATIONS_DRAIN_SECRET=some-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production site URL — used by Supabase auth emails (verify, reset password).
# In production this must match the Site URL configured in the Supabase dashboard
# (Authentication → URL Configuration). Set to your Azure App Service URL, e.g.:
# NEXT_PUBLIC_SITE_URL=https://dolmenwood-prod-web.azurewebsites.net
NEXT_PUBLIC_SITE_URL=http://localhost:3000
